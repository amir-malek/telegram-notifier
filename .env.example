# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
# Set to false to disable PostgreSQL and use in-memory storage
# WARNING: When database is disabled:
# - Data will not persist across restarts
# - Limited query capabilities (no complex filtering/sorting)
# - Memory usage will grow with stored data
# - Suitable for development and simple deployments only
DATABASE_ENABLED=false
DATABASE_URL=postgresql://user:password@localhost:5432/notification_service
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notification_service
DB_USER=postgres
DB_PASSWORD=password

# Storage Configuration
# Modes: auto (try database, fallback to memory), database (force database), memory (force memory)
STORAGE_MODE=auto
# Maximum records to keep in memory per collection (notifications, clients, etc.)
MEMORY_STORAGE_LIMIT=1000

# Redis Configuration
# Set to false to disable Redis and use in-memory alternatives
# WARNING: When Redis is disabled:
# - Queue data will not persist across restarts
# - Rate limiting is per-instance only (not distributed)
# - Not recommended for production with multiple instances
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here
REFRESH_TOKEN_EXPIRES_IN=7d

# API Key Configuration
API_KEY_SECRET=your-super-secret-api-key-change-in-production

# API Configuration
API_VERSION=v1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_REQUEST_SIZE=10mb

# Telegram Configuration
# IMPORTANT: The service now operates as a passive gateway
# Bot tokens should be provided by clients via the X-Telegram-Bot-Token header
# The TELEGRAM_BOT_TOKEN environment variable is OPTIONAL and only used for testing
# Production deployments should NOT set this variable - clients provide their own tokens
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhooks/telegram

# Slack Configuration (optional)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=notifications@yourcompany.com

# Monitoring
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
LOG_LEVEL=info

# Queue Configuration
QUEUE_REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=5
QUEUE_ATTEMPTS=3
QUEUE_DELAY=5000

# Security
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
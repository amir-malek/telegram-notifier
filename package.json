{
  "name": "notification-service",
  "version": "1.0.0",
  "description": "Multi-channel notification service with REST API",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "migrate": "ts-node scripts/migrate.ts",
    "seed": "ts-node scripts/seed.ts",
    "docker:build": "./scripts/docker/build.sh",
    "docker:dev:start": "./scripts/docker/dev-start.sh",
    "docker:dev:admin": "./scripts/docker/dev-start.sh --admin",
    "docker:dev:stop": "docker-compose -f docker-compose.dev.yml down",
    "docker:prod:up": "docker-compose up -d",
    "docker:prod:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f notification-service"
  },
  "keywords": [
    "notification",
    "api",
    "telegram",
    "queue",
    "microservice"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "pg": "^8.12.0",
    "ioredis": "^5.4.1",
    "redis": "^4.7.0",
    "bull": "^4.16.0",
    "handlebars": "^4.7.8",
    "node-telegram-bot-api": "^0.66.0",
    "axios": "^1.7.7",
    "winston": "^3.13.1",
    "prom-client": "^15.1.3",
    "joi": "^17.13.3",
    "uuid": "^10.0.0",
    "crypto": "^1.0.1",
    "yamljs": "^0.3.0",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.8",
    "@types/bull": "^4.10.0",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/jest": "^29.5.12",
    "@types/uuid": "^10.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/yamljs": "^0.2.34",
    "@types/swagger-ui-express": "^4.1.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^9.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

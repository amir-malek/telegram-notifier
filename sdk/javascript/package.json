{
  "name": "@notification-service/client",
  "version": "1.0.0",
  "description": "JavaScript/TypeScript client SDK for Notification Service API",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "docs": "typedoc src/index.ts --out docs --theme minimal"
  },
  "keywords": [
    "notification",
    "api",
    "client",
    "sdk",
    "telegram",
    "typescript",
    "javascript"
  ],
  "author": "Notification Service Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourorg/notification-service"
  },
  "bugs": {
    "url": "https://github.com/yourorg/notification-service/issues"
  },
  "homepage": "https://github.com/yourorg/notification-service#readme",
  "dependencies": {
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^9.10.0",
    "jest": "^29.7.0",
    "rollup": "^4.21.2",
    "@rollup/plugin-typescript": "^12.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-commonjs": "^26.0.1",
    "rollup-plugin-dts": "^6.1.1",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.26.7",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "axios": "^1.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}